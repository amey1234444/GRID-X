# ---------------------------------------------------------------------------
# GRID-X environment
# Copy to .env at the repository root. Both apps read from this single file.
# ---------------------------------------------------------------------------

# Database (Neon or any managed PostgreSQL in production)
DATABASE_URL="postgresql://gridx:gridx@localhost:5432/gridx?schema=public"

# API
API_PORT=4000
API_GLOBAL_PREFIX=api
CORS_ORIGINS="http://localhost:3000"
# Absolute URL of the web app, used in notification links.
WEB_APP_URL="http://localhost:3000"

# Auth
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
SESSION_IDLE_TIMEOUT_MINUTES=60
OTP_TTL_MINUTES=10

# File storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./storage"
STORAGE_SIGNED_URL_TTL_SECONDS=300
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET="gridx"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=true

# Notifications (MVP: in-app always on; email/whatsapp optional)
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="GRID-X <no-reply@oswar.example>"
NOTIFY_WHATSAPP_ENABLED=false
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# ---------------------------------------------------------------------------
# IMS boundary — masters flow in, outsourcing facts flow back out.
# ---------------------------------------------------------------------------
# Master switch. Nothing below has any effect while this is false.
IMS_ENABLED=false

# Transport: database | http | disabled | auto (default). "auto" picks the
# database driver when IMS_DATABASE_URL is set, else http when IMS_BASE_URL is.
#
# The recommended shape is both: IMS_DRIVER=database for reads (the IMS REST API
# has no "since" filter and no paging, so every HTTP read is a full table scan)
# and IMS_WRITE_MODE=http for writes (the API enforces stock availability and
# weighted-average costing that a direct INSERT would silently bypass).
IMS_DRIVER=database

# The IMS organisation GRID-X speaks for. The IMS is multi-tenant: every
# material, warehouse, supplier and ledger row carries an org_id. REQUIRED for
# the database driver, which refuses to read unscoped rather than pull every
# company's catalogue. Find it with: select id, slug, name from organizations;
IMS_ORG_ID=""

# --- Direct database connection (IMS_DRIVER=database) -----------------------
# The IMS PostgreSQL connection string. Use a role with SELECT on the IMS
# masters and rights on the GRID-X outbox schema only — nothing more.
IMS_DATABASE_URL=""
# NOT "public". The OSWAR IMS lives in the "ims" schema of a shared Supabase
# database whose public schema belongs to the CRM. Its own DATABASE_URL carries
# ?schema=ims. Getting this wrong reads as "no tables found".
IMS_DATABASE_SCHEMA="ims"
IMS_DB_POOL_MAX=5
IMS_DB_CONNECTION_TIMEOUT_MS=10000
# Server-side ceiling per statement, so a bad mapping cannot pin the IMS.
IMS_DB_STATEMENT_TIMEOUT_MS=15000
IMS_DB_IDLE_TIMEOUT_MS=30000
# require (verify the certificate) | no-verify (managed providers) | disable.
# Supabase (where the IMS is hosted) needs no-verify: the connection is still
# encrypted, only the certificate chain is not checked against Node's root store.
IMS_DB_SSL=no-verify
# Shows up in the IMS pg_stat_activity, so a DBA can see who is connected.
IMS_DB_APPLICATION_NAME="gridx-ims"

# --- Schema mapping ---------------------------------------------------------
# oswar (default) = the real OSWAR IMS, transcribed from its schema.prisma.
# prisma = PascalCase tables + camelCase columns; snake = plural snake_case.
# Change this only when pointing GRID-X at a different IMS.
IMS_MAPPING_PROFILE=oswar
# Per-entity overrides. Generate a starting point with: pnpm ims:introspect --write
IMS_MAPPING_FILE=""
IMS_MAPPING_JSON=""

# --- Outbound facts ---------------------------------------------------------
# outbox = insert into GRID-X own table inside the IMS database (default and
# safest; GRID-X never writes to a table the IMS owns) | http | none.
IMS_WRITE_MODE=outbox
IMS_OUTBOX_SCHEMA="gridx"
IMS_OUTBOX_TABLE="ims_outbound_fact"
# Set false when the IMS role may not create schemas; a DBA runs
# packages/db/prisma/ims/001_gridx_outbox.sql once instead (pnpm ims:outbox).
IMS_OUTBOX_AUTO_CREATE=true

# --- Scheduled inbound sync -------------------------------------------------
# Defaults to on when IMS_DATABASE_URL is set. Runs every 30 minutes.
IMS_SYNC_INBOUND_ENABLED=true
# The OSWAR IMS publishes no product master, no sales orders, no work orders and
# no purchase orders — its production module was removed. Only companies and
# items are both persisted by GRID-X and available to pull.
IMS_SYNC_ENTITIES="companies,items"
IMS_SYNC_BATCH_SIZE=500

# --- REST transport (IMS_DRIVER=http, or IMS_WRITE_MODE=http) ---------------
# Include the IMS global prefix, e.g. https://ims.oswar.example/api/v1
IMS_BASE_URL=""
# The IMS issues no API keys and has no client-credentials flow: POST /auth/login
# with an email and password is the only way in. Create a dedicated IMS user for
# GRID-X rather than reusing a person's login. It needs the ADMIN role — the IMS
# redacts unit prices and refuses the members list below that.
IMS_AUTH_EMAIL=""
IMS_AUTH_PASSWORD=""
# Only for an IMS deployment that hands out a pre-issued bearer token.
IMS_API_KEY=""
IMS_TIMEOUT_MS=15000

# Whether GRID-X may post real stock movements into the IMS ledger
# (type OUTSOURCE, when material is issued to a partner).
# Off by default: POST /transactions/bulk accepts no idempotency key, so a retry
# after a lost response issues the same material twice. Turn it on only once you
# accept that the IMS ledger may occasionally need a manual correction.
IMS_HTTP_POST_STOCK=false
# The IMS warehouse UUID outsourced material is issued from and returned to.
# Required when IMS_HTTP_POST_STOCK is on.
IMS_ISSUE_WAREHOUSE_ID=""

# Monitoring. Leave blank to disable error reporting.
SENTRY_DSN=""

# Seed data: the password given to every seeded account.
SEED_PASSWORD="ChangeMe123!"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_NAME="GRID-X"
# Path prefix the API is mounted under; must match API_GLOBAL_PREFIX.
NEXT_PUBLIC_API_PREFIX=api
# Server-side override for the API base URL. Useful when the browser and the
# Next.js server reach the API on different hostnames (containers, private
# networking). Falls back to NEXT_PUBLIC_API_URL when unset.
API_URL=""
