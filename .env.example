# ---------------------------------------------------------------------------
# GRID-X environment
# Copy to .env at the repository root. Both apps read from this single file.
# ---------------------------------------------------------------------------

# Database (Neon or any managed PostgreSQL in production)
DATABASE_URL="postgresql://gridx:gridx@localhost:5432/gridx?schema=public"

# API
API_PORT=4000
API_GLOBAL_PREFIX=api
CORS_ORIGINS="http://localhost:3000"

# Auth
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
SESSION_IDLE_TIMEOUT_MINUTES=60
OTP_TTL_MINUTES=10

# File storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./storage"
STORAGE_SIGNED_URL_TTL_SECONDS=300
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET="gridx"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=true

# Notifications (MVP: in-app always on; email/whatsapp optional)
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="GRID-X <no-reply@oswar.example>"
NOTIFY_WHATSAPP_ENABLED=false
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# Monitoring
SENTRY_DSN=""

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_NAME="GRID-X"
